rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーが自分のドキュメントにアクセスしているか確認
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // デッキのドキュメントに対するルール
    match /users/{userId}/decks/{deckId} {
      // 共有リンクでの単体取得は公開。保存済み一覧の列挙は所有者だけ。
      allow get: if true;
      allow list: if isOwner(userId);

      // 作成: 所有者のみ・許可されたフィールドのみ書き込み可能
      // 注: build/2pick/ログイン後保存で送るキーが異なるため hasAll ではなく
      //     hasOnly（許可リストのサブセット）で検証する
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'name',
          'yojoDeckIds',
          'sweetDeckIds',
          'playableCardId',
          'createdAt',
          'updatedAt',
          'is2pick',
        ]);

      // 更新: 所有者のみ・変更できるフィールドを制限
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'yojoDeckIds', 'sweetDeckIds', 'playableCardId', 'updatedAt', 'is2pick']);

      // 削除: 所有者のみ
      allow delete: if isOwner(userId);
    }

    // Public game profiles contain only a chosen name, card icon, short comment and up to 3 of the player's (already public) decks.
    match /profiles/{userId} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(['displayName', 'comment', 'iconCardId', 'decks', 'createdAt', 'updatedAt']) &&
          (!('decks' in request.resource.data) || request.resource.data.decks is list && request.resource.data.decks.size() <= 3) &&
          request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 12 &&
          request.resource.data.comment is string && request.resource.data.comment.size() <= 80 &&
          request.resource.data.iconCardId is string && request.resource.data.iconCardId.matches('[a-z]+_[0-9]+') &&
          request.resource.data.updatedAt == request.time;
      }
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(userId) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /friendships/{friendId} {
      function member() { return request.auth != null && request.auth.uid in resource.data.members; }
      allow get: if request.auth != null && (resource == null || member());
      allow list: if member() && request.query.limit <= 100;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'createdAt']) &&
        request.resource.data.members is list && request.resource.data.members.size() == 2 &&
        request.resource.data.members[0] is string && request.resource.data.members[1] is string &&
        request.resource.data.members[0] < request.resource.data.members[1] &&
        friendId == request.resource.data.members[0] + '~' + request.resource.data.members[1] &&
        request.auth.uid in request.resource.data.members && request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[0])) &&
        exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[1]));
      allow update: if member() && resource.data.requestedBy != request.auth.uid && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']) &&
        request.resource.data.status == 'accepted' && request.resource.data.acceptedAt == request.time;
      allow delete: if member();
    }

    match /recruitments/{userId} {
      function friends() {
        let key = request.auth.uid < userId ? request.auth.uid + '~' + userId : userId + '~' + request.auth.uid;
        return exists(/databases/$(database)/documents/friendships/$(key)) &&
          get(/databases/$(database)/documents/friendships/$(key)).data.status == 'accepted';
      }
      allow get: if request.auth != null && (isOwner(userId) || friends());
      allow list: if false;
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['roomId', 'updatedAt']) &&
        request.resource.data.roomId is string && request.resource.data.roomId.matches('[0-9]{6}') &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    // 観戦中のルーム。募集と同じく、承認済みフレンドだけが読める。観戦中は1分ごとに更新し、古いものは表示しない。
    match /watching/{userId} {
      function friends() {
        let key = request.auth.uid < userId ? request.auth.uid + '~' + userId : userId + '~' + request.auth.uid;
        return exists(/databases/$(database)/documents/friendships/$(key)) &&
          get(/databases/$(database)/documents/friendships/$(key)).data.status == 'accepted';
      }
      allow get: if request.auth != null && (isOwner(userId) || friends());
      allow list: if false;
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['roomId', 'updatedAt']) &&
        request.resource.data.roomId is string && request.resource.data.roomId.matches('[0-9]{6}') &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    // その他のドキュメントへのアクセスは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
