rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーが自分のドキュメントにアクセスしているか確認
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // デッキのドキュメントに対するルール
    match /users/{userId}/decks/{deckId} {
      // 読み取り: 誰でも可（デッキ共有・OGP生成のため意図的に公開）
      allow read: if true;

      // 作成: 所有者のみ・許可されたフィールドのみ書き込み可能
      // 注: build/2pick/ログイン後保存で送るキーが異なるため hasAll ではなく
      //     hasOnly（許可リストのサブセット）で検証する
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'name',
          'yojoDeckIds',
          'sweetDeckIds',
          'playableCardId',
          'createdAt',
          'updatedAt',
          'is2pick',
        ]);

      // 更新: 所有者のみ・変更できるフィールドを制限
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'yojoDeckIds', 'sweetDeckIds', 'playableCardId', 'updatedAt', 'is2pick']);

      // 削除: 所有者のみ
      allow delete: if isOwner(userId);
    }

    // その他のドキュメントへのアクセスは拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
