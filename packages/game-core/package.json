{
  "name": "@pplale/game-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ai": {
      "types": "./src/ai/index.ts",
      "default": "./src/ai/index.ts"
    },
    "./train": {
      "types": "./src/ai/value-train.ts",
      "default": "./src/ai/value-train.ts"
    },
    "./room": {
      "types": "./src/room.ts",
      "default": "./src/room.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    },
    "./performance": {
      "types": "./src/performance.ts",
      "default": "./src/performance.ts"
    },
    "./history": {
      "types": "./src/history.ts",
      "default": "./src/history.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "arena": "pnpm run build && node scripts/arena.mjs",
    "train": "pnpm run build && node scripts/train.mjs",
    "deck": "pnpm run build && node scripts/deck-search.mjs",
    "value": "pnpm run build && node scripts/value.mjs",
    "policy": "pnpm run build && node scripts/policy.mjs",
    "compare": "pnpm run build && node scripts/compare.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
