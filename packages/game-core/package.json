{
  "name": "@pplale/game-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ai": {
      "types": "./src/ai/index.ts",
      "default": "./src/ai/index.ts"
    },
    "./snapshot": {
      "types": "./src/snapshot.ts",
      "default": "./src/snapshot.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "arena": "npm run build && node scripts/arena.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
