{
  "name": "pplale",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x || 26.x"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "panda codegen && husky",
    "predev": "panda codegen && pnpm run fonts:generate && pnpm run cards:generate",
    "prebuild": "panda codegen && pnpm --filter @pplale/game-core run build && pnpm run fonts:generate && pnpm run cards:generate",
    "dev": "next dev",
    "dev:rooms": "node scripts/dev-with-rooms.mjs",
    "build": "next build",
    "export": "next export",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:game": "pnpm --filter @pplale/game-core run test",
    "test:play-performance": "node --test tests/play-performance.test.mjs",
    "test:cpu-server": "pnpm --filter @pplale/cpu-server run test",
    "pretest:room-server": "pnpm --filter @pplale/game-core run build",
    "test:room-server": "pnpm --filter @pplale/room-server run test",
    "cpu:arena": "pnpm --filter @pplale/game-core run arena",
    "cpu:train": "pnpm --filter @pplale/game-core run train",
    "cpu:deck": "pnpm --filter @pplale/game-core run deck",
    "cpu:value": "pnpm --filter @pplale/game-core run value",
    "cpu:policy": "pnpm --filter @pplale/game-core run policy",
    "cpu:compare": "pnpm --filter @pplale/game-core run compare",
    "cards:import-en": "node scripts/import-english-cards.mjs",
    "cards:optimize": "node scripts/optimize-images.mjs",
    "cards:og-images": "node scripts/generate-og-images.mjs",
    "cards:thumbnails": "node scripts/generate-deck-thumbnails.mjs",
    "puzzles:images": "node scripts/generate-puzzle-previews.mjs",
    "cards:generate": "pnpm run cards:og-images && pnpm run cards:thumbnails && pnpm run game:assets",
    "pretest:deck-images": "pnpm run cards:generate",
    "test:deck-images": "node --test tests/ogDeckImage.test.mjs tests/deckImageLayout.test.mjs",
    "cards:check": "node scripts/check-cards.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fonts:generate": "node scripts/generate-site-fonts.mjs",
    "pretest:fonts": "pnpm run fonts:generate",
    "test:fonts": "node --test tests/site-fonts.test.mjs",
    "game:assets": "node scripts/generate-game-assets.mjs",
    "pretest:game-assets": "pnpm run game:assets",
    "test:game-assets": "node --test tests/game-assets.test.mjs",
    "check:ui": "node --test tests/ui-structure.test.mjs && node scripts/check-ui-structure.mjs"
  },
  "dependencies": {
    "@pplale/game-core": "workspace:*",
    "@vercel/og": "^1.0.3",
    "@vercel/speed-insights": "^2.0.0",
    "critters": "^0.0.25",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.0.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@pandacss/dev": "^0.31.0",
    "@playwright/test": "^1.62.1",
    "@svgr/plugin-svgo": "^8.1.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.20.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "file-loader": "^6.2.0",
    "fontkit": "2.0.4",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "subset-font": "2.9.0",
    "typescript": "^5"
  }
}
